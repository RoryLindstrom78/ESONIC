  pinkyL_buttonState = digitalRead(pinkyL_buttonPIN);

  //catch button press (when digital read HIGH)
  if(pinkyL_buttonState == HIGH){
    Serial.println("Left Pinky Button Pressed!");
    pinkyL_pushed = !pinkyL_pushed;
    delay(50);
  }

  //0 to 1 state
  //check button is pressed == 1 and program is in 0 state
  if(pinkyL_pushed == HIGH && pinkyL_lastState == LOW){
  Serial.println("Pinky L 1 State");
