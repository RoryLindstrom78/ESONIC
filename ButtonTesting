void setup() {
  // put your setup code here, to run once:
  Serial.begin(115200);

  // **Note: make sure pinModes are INPUT_PULLDOWN (default/initial state = 0)
  //Initialize Left Hand Pinmodes:
  pinMode(indexL_buttonPIN, INPUT_PULLDOWN);  //L index button
  pinMode(middleL_buttonPIN, INPUT_PULLDOWN); //L middle button
  pinMode(ringL_buttonPIN, INPUT_PULLDOWN);   //L ring button
  pinMode(pinkyL_buttonPIN, INPUT_PULLDOWN);  //L pinky button

}

void loop() {
  // call button functions for each button
  indexL(indexL_buttonPIN);
  middleL(middleL_buttonPIN);
  ringL(ringL_buttonPIN);
  pinkyL(pinkyL_buttonPIN);
  
  delay(200);  
}
