//Left Hand Button code
/* Implementation of Player 1 Left Hand Buttons (1 ESP per 1 Hand)
*/

//Reminder: dont forget MPU pins, change button pins as needed
//Left Hand Pins:
const int indexL_buttonPIN = 14 ;
const int middleL_buttonPIN = 27;
const int ringL_buttonPIN =26 ;
const int pinkyL_buttonPIN = 25;

//State parameters for Index Button
int indexL_buttonState = 0;
int indexL_lastState = LOW;
int indexL_pushed = LOW;

//State parameters for Middle Button
int middleL_buttonState = 0;
int middleL_lastState = LOW;
int middleL_pushed = LOW;

//State parameters for Ring Button
int ringL_buttonState = 0;
int ringL_lastState = LOW;
int ringL_pushed = LOW;

//State parameters for Ring Button
int pinkyL_buttonState = 0;
int pinkyL_lastState = LOW;
int pinkyL_pushed = LOW;

void indexL(int indxLPIN){
  //read button state
  indexL_buttonState = digitalRead(indexL_buttonPIN);

  //catch button press (when digital read HIGH)
  if(indexL_buttonState == HIGH){
    Serial.println("Left Index Button Pressed!");
    indexL_pushed = !indexL_pushed;
    delay(50);
  }

  //0 to 1 state
  //check button is pressed == 1 and program is in 0 state
  if(indexL_pushed == HIGH && indexL_lastState == LOW){
  Serial.println("Index L 1 State");
    indexL_lastState = HIGH; //set last state to HIGH
    delay(100); //delay
  }
  //1 to 0 state
  //check button is pressed ==1 and progam is in 1 state
  else if(indexL_buttonState == HIGH && indexL_lastState == HIGH){
    Serial.println("Index L 0 State");
    indexL_lastState = LOW; //set last state to LOW
    delay(100);
  }
  //print current state
  Serial.print("Index L State:");
  Serial.println(indexL_lastState);
  //Serial.println(" ");
}

